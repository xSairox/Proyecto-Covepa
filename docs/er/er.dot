digraph ER {
graph [rankdir=LR, splines=polyline, nodesep=0.35, ranksep=1.1, fontname="Helvetica", pad=0.4, bgcolor="white", label=<<FONT POINT-SIZE="22"><B>COVEPA Mantenciones · Modelo entidad-relación</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#5F5A4B">PostgreSQL (Neon) en amarillo · MongoDB Atlas en rojo · Cloudinary guarda solo las URL</FONT>>, labelloc=t];

# --- Django ---------------------------------------------------------------
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app
# Clave para cifrar los secretos 2FA (Fernet, 32 bytes en base64 url-safe). Opcional: si falta se deriva de SECRET_KEY.
FIELD_ENCRYPTION_KEY=
LOG_LEVEL=INFO
# HTTPS obligatorio (redirección, cookies seguras, HSTS). Por defecto: activo en Vercel, apagado con runserver.
# FORZAR_HTTPS=False

# --- PostgreSQL en Neon ---------------------------------------------------
# EN LOCAL, DEJA ESTAS LÍNEAS COMENTADAS (con #): sin ellas se usa SQLite y MongoDB en memoria.
# Quita el # solo cuando tengas las cadenas reales de Neon y Atlas.
# Runtime (Vercel): cadena POOLED (host con "-pooler")
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Migraciones: cadena DIRECTA (sin "-pooler"). Se usa solo con "manage.py migrate".
# DIRECT_DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=60

# --- MongoDB Atlas --------------------------------------------------------
# MONGODB_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=covepa

# --- Cloudinary -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=covepa/mantenciones

# --- Correo (invitaciones y recuperación de contraseña) -------------------
# Sin SMTP, los enlaces se muestran en pantalla a la jefatura y en los logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=COVEPA Mantenciones <no-reply@covepa.cl>

# --- Vercel Cron ----------------------------------------------------------
# Vercel envía "Authorization: Bearer <CRON_SECRET>" a las rutas de /crons.
CRON_SECRET=
